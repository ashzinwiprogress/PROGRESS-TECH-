# Optional but recommended on Vercel
# 1) Vercel Blob: stores admin content, visitor log and uploaded images so they persist.
#    Create a Blob store in your Vercel project (Storage tab) and it is injected automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# 2) Email sending through Resend (optional). Without it, the email form opens the
#    user's mail app pre-filled with the message to progresstech237@gmail.com.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=Progress Tech <onboarding@resend.dev>
